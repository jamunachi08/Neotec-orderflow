 "fields": [
  {"fieldname": "general_section", "fieldtype": "Section Break", "label": "General"},
  {"fieldname": "enabled", "fieldtype": "Check", "label": "Enable Neotec OrderFlow", "default": "1"},
  {"fieldname": "region", "fieldtype": "Select", "label": "Compliance Region",
   "options": "None\nIndia\nKSA", "default": "None",
   "description": "India: GST pre-flight (state/GSTIN/tax-type/HSN). KSA: VAT pre-flight (TRN, branch dispatch, item tax templates)."},

  {"fieldname": "quotation_section", "fieldtype": "Section Break", "label": "Quotation Tools"},
  {"fieldname": "enable_stock_viewer", "fieldtype": "Check", "label": "Enable Stock Availability Window", "default": "1"},
  {"fieldname": "viewer_open_on_item", "fieldtype": "Check", "label": "Auto-open Window on Item Selection", "default": "1",
   "depends_on": "enable_stock_viewer"},
  {"fieldname": "col_q1", "fieldtype": "Column Break"},
  {"fieldname": "print_availability_mode", "fieldtype": "Select", "label": "Print Format Availability",
   "options": "Ticks\nQuantities\nOff", "default": "Ticks",
   "description": "Ticks: customer-safe check/dash per warehouse. Quantities: prints actual qty."},
  {"fieldname": "enable_partial_state", "fieldtype": "Check", "label": "Show PARTIAL (amber) State on Print", "default": "1"},

  {"fieldname": "generator_section", "fieldtype": "Section Break", "label": "Sales Order Generation (from Quotation)"},
  {"fieldname": "enable_so_generator", "fieldtype": "Check", "label": "Enable 'Create Sales Order (Warehouse-wise)' Button", "default": "1"},
  {"fieldname": "default_grouping", "fieldtype": "Select", "label": "Default Grouping",
   "options": "single\nwarehouse\nstate", "default": "single"},
  {"fieldname": "delivery_days_offset", "fieldtype": "Int", "label": "Default Delivery Date Offset (days)", "default": "0"},
  {"fieldname": "col_g1", "fieldtype": "Column Break"},
  {"fieldname": "include_draft_so_in_balance", "fieldtype": "Check",
   "label": "Count Draft Sales Orders in Quotation Balance", "default": "1",
   "description": "Prevents two users allocating the same balance concurrently. Recommended ON."},
  {"fieldname": "enable_so_allocator", "fieldtype": "Check",
   "label": "Enable Manual Allocator on Sales Order (direct entry)", "default": "1"},

  {"fieldname": "auto_section", "fieldtype": "Section Break", "label": "Auto-Create Sales Order on Quotation Submit"},
  {"fieldname": "enable_auto_so", "fieldtype": "Check", "label": "Enable Auto-Creation", "default": "0"},
  {"fieldname": "auto_grouping", "fieldtype": "Select", "label": "Auto Grouping Mode",
   "options": "single\nwarehouse\nstate", "default": "single", "depends_on": "enable_auto_so"},
  {"fieldname": "col_a1", "fieldtype": "Column Break"},
  {"fieldname": "auto_note", "fieldtype": "HTML", "options":
   "<div class='text-muted small'>Auto-creation only fires when EVERY item is fully coverable by available stock AND the compliance pre-flight returns no errors and no warnings. Anything ambiguous is skipped with a comment on the Quotation. Auto-created orders are always drafts.</div>"},

  {"fieldname": "compliance_section", "fieldtype": "Section Break", "label": "Compliance Pre-flight"},
  {"fieldname": "enable_compliance_checks", "fieldtype": "Check", "label": "Enable Compliance Checks", "default": "1"},
  {"fieldname": "tax_flip_is_error", "fieldtype": "Check",
   "label": "Treat Tax-Type Change (IGST vs CGST/SGST) as Blocking Error", "default": "0",
   "depends_on": "eval:doc.region=='India'"},

  {"fieldname": "stock_section", "fieldtype": "Section Break", "label": "Stock Availability Formula"},
  {"fieldname": "deduct_reserved_qty", "fieldtype": "Check", "label": "Deduct Reserved Qty (SO reservation)", "default": "1"},
  {"fieldname": "deduct_reserved_stock", "fieldtype": "Check", "label": "Deduct Reserved Stock (v15 Stock Reservation)", "default": "1"},
  {"fieldname": "exclude_transit", "fieldtype": "Check", "label": "Exclude Transit-type Warehouses", "default": "1"},

  {"fieldname": "advanced_section", "fieldtype": "Section Break", "label": "Advanced", "collapsible": 1},
  {"fieldname": "extra_copy_fields", "fieldtype": "Data", "label": "Extra Item Fields to Copy (comma-separated)",
   "default": "custom_cb_rate",
   "description": "Custom fieldnames on Quotation Item to carry onto generated Sales Order Item rows."}
